{
  "type": "module",
  "engines": {
    "node": "^24.22.2 || ^26.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc --watch",
    "dev": "vite",
    "host": "vite --host",
    "generate-thumbs": "node scripts/generate-thumbs.ts",
    "build": "tsc && npm run generate-thumbs && vite build",
    "build:shop": "tsc && npm run generate-thumbs && VITE_SHOP=1 vite build",
    "dev:shop": "VITE_SHOP=1 vite",
    "preview": "vite preview"
  }
}
